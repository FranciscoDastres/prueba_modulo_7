{
  "info": {
    "name": "ABP Parte 2 - Módulo 7",
    "description": "Ejecutar en orden con npm start. Los IDs se guardan automáticamente. El rollback con fallo de la segunda inserción se documenta mediante npm run verify.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
