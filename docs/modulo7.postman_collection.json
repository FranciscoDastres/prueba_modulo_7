        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/usuarios",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Usuario Postman\",\n  \"email\": \"postman_{{$timestamp}}@ejemplo.cl\",\n  \"biografia\": \"Perfil creado en una transacción.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código HTTP esperado\", () => pm.response.to.have.status(201));",
              "pm.test(\"Formato de respuesta\", () => { const data = pm.response.json(); pm.expect(data).to.have.keys(\"status\", \"message\", \"data\"); });",
              "if (pm.response.code === 201) { pm.collectionVariables.set(\"usuario_id\", pm.response.json().data.usuario.id); }"
            ]
          }
        }
      ]
    },
