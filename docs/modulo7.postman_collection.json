    {
      "key": "pedido_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Estado PostgreSQL",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código HTTP esperado\", () => pm.response.to.have.status(200));",
              "pm.test(\"Formato de respuesta\", () => { const data = pm.response.json(); pm.expect(data).to.have.keys(\"status\", \"message\", \"data\"); });"
            ]
          }
        }
      ]
    },
